{
  "name": "@nourhelmi/agent-router",
  "version": "0.1.0",
  "description": "Authoritative task-fit routing with Jev, quota constraints, and provenance-aware benchmarks",
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
